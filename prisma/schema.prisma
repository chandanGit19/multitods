generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id          String        @id @default(uuid())
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime       @updatedAt
  GroupInvite GroupInvite[]
  GroupMember GroupMember[]
  Task        Task[]
}

model GroupInvite {
  id                                String            @id @default(uuid())
  groupId                           String
  inviterId                         String
  inviteedId                        String
  status                            GroupInviteStatus @default(PENDING)
  createdAt                         DateTime          @default(now())
  updatedAt                         DateTime           @updatedAt
  respondedAt                       DateTime?
  Group                             Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  User_GroupInvite_inviteedIdToUser User              @relation("GroupInvite_inviteedIdToUser", fields: [inviteedId], references: [id], onDelete: Cascade)
  User_GroupInvite_inviterIdToUser  User              @relation("GroupInvite_inviterIdToUser", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([inviteedId, status])
}

model GroupMember {
  id      String    @id @default(uuid())
  groupId String
  userId  String
  role    GroupRole @default(MEMBER)
  joindAt DateTime  @default(now())
  Group   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  User    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
}

model Task {
  id                           String      @id @default(uuid())
  groupId                      String
  title                        String
  description                  String?
  assignedToId                 String?
  createdById                  String
  status                       TaskStatus  @default(TODO)
  dueAt                        DateTime?
  createdAt                    DateTime    @default(now())
  assignedAt                   DateTime?
  pickedUpAt                   DateTime?
  completedAt                  DateTime?
  User_Task_assignedToIdToUser User?       @relation("Task_assignedToIdToUser", fields: [assignedToId], references: [id])
  User_Task_createdByIdToUser  User        @relation("Task_createdByIdToUser", fields: [createdById], references: [id])
  Group                        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  TaskEvent                    TaskEvent[]

  @@index([assignedToId, status])
  @@index([groupId, status])
}

model TaskEvent {
  id        String        @id @default(uuid())
  taskId    String
  actorId   String
  type      TaskEventType
  remark    String
  createdAt DateTime      @default(now())
  User      User          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  Task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model User {
  id                                       String        @id @default(uuid())
  name                                     String
  email                                    String        @unique
  passwordHash                             String
  createdAt                                DateTime      @default(now())
  updateAt                                 DateTime      @updatedAt
  GroupInvite_GroupInvite_inviteedIdToUser GroupInvite[] @relation("GroupInvite_inviteedIdToUser")
  GroupInvite_GroupInvite_inviterIdToUser  GroupInvite[] @relation("GroupInvite_inviterIdToUser")
  GroupMember                              GroupMember[]
  Task_Task_assignedToIdToUser             Task[]        @relation("Task_assignedToIdToUser")
  Task_Task_createdByIdToUser              Task[]        @relation("Task_createdByIdToUser")
  TaskEvent                                TaskEvent[]
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskEventType {
  CREATED
  ASSIGNED
  COMPLETED
  REOPENED
  CANCELLED
  REMARK_ADDED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
